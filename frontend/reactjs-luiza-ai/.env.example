# Copie este arquivo para .env.local e preencha os valores.
# NUNCA faça commit de .env.local (ele está no .gitignore).

# Google Cloud Text-to-Speech (voz da avatar, pt-BR).
VITE_TTS_ENDPOINT=https://texttospeech.googleapis.com/v1beta1/text:synthesize
VITE_TTS_API_KEY=coloque_sua_chave_aqui

# Avatar 3D (Ready Player Me). Opções, em ordem de prioridade:
# 1) URL direta de um .glb (local ou remoto):
VITE_AVATAR_URL=/models/luiza-camisa-preta.glb
# 2) ID de um avatar Ready Player Me (https://readyplayer.me):
# VITE_AVATAR_ID=coloque_o_id_aqui
# VITE_AVATAR_BODY=F   # F (feminino) ou M (masculino)
